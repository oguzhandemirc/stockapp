    "android": {
      "package": "com.oguzhandemirc.appstock",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 1
    },
    "web": {
      "favicon": "./app/assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f6c8e786-efb8-49c9-a19f-64547bbee386"
      }
    }
  }
